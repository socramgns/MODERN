  "tests": [
    {
      "name": "Source profiles use the actual catalog passcodes and printed recipe",
      "pass": true
    },
    {
      "name": "Level five Synchro uses actual materials, vacated zones, proper history and no self draw",
      "pass": true
    },
    {
      "name": "One Tuner and three physical non-Tuners can meet level five",
      "pass": true
    },
    {
      "name": "Opponent can perform reviewed Librarian Synchro and existing opposing Librarian draws only a known physical top card",
      "pass": true
    },
    {
      "name": "Librarian draw with unknown order remains pending without a fabricated card",
      "pass": true
    },
    {
      "name": "Invalid level, second Tuner, facedown, attachments and restrictions never become Synchro materials",
      "pass": true
    },
    {
      "name": "Duplicate, foreign and wrong-sum requested material UIDs cannot execute",
      "pass": true
    },
    {
      "name": "Player scoped Fusion and Wyrm locks are checked before material payment",
      "pass": true
    },
    {
      "name": "A controlled material returns to its physical owner without changing inventory",
      "pass": true
    },
    {
      "name": "Declared banishment creates no Chengying trigger and no summon history",
      "pass": true
    },
    {
      "name": "Both players optional Chengying effects use SEGOC, choose no target at activation and resolve after source departure",
      "pass": true
    },
    {
      "name": "Declining the optional trigger preserves use and moves no new card",
      "pass": true
    },
    {
      "name": "If the opponent GY empties before resolution, Chengying banishes neither zone and keeps its named use",
      "pass": true
    },
    {
      "name": "Banishment as an activation cost waits until the existing chain ends",
      "pass": true
    },
    {
      "name": "Replacement uses one actual own GY card, starts no chain, has no once-per-turn budget and never protects battle destruction",
      "pass": true
    },
    {
      "name": "Negated or facedown Chengying has no replacement; a physical opponent GY cost cannot be substituted",
      "pass": true
    },
    {
      "name": "Replacement preserves the source and pays even when Roar negates its activation; replay verifies the cost",
      "pass": true
    },
    {
      "name": "Chengying continuous ATK/DEF remains counted once by the existing core",
      "pass": true
    },
    {
      "name": "Two materials banished during one Fusion resolution create only one optional Chengying opportunity",
      "pass": true
    },
    {
      "name": "Attack declaration remains a legal Chengying banishment trigger window before the Damage Step starts",
      "pass": true
    },
    {
      "name": "Actual banishment after damage calculation does not create Chengying optional triggers",
      "pass": true
    },
    {
      "name": "Cyber Twin Invocation pays no materials at activation and resolves with two distinct hand Cyber Dragons",
      "pass": true
    },
    {
      "name": "Cyber Twin Invocation cannot substitute a same-level monster or use a field or GY Cyber Dragon",
      "pass": true
    },
    {
      "name": "A negated Cyber Twin Fusion leaves both physical materials in hand and establishes no proper history",
      "pass": true
    },
    {
      "name": "A genuinely Synchro Summoned Librarian can be revived after witnessed battle departure; a declared GY copy cannot",
      "pass": true
    },
    {
      "name": "Genuine Cyber Twin Fusion history survives battle departure and enables physical Monster Reborn",
      "pass": true
    }
