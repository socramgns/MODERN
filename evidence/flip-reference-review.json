  "claims": [
    {
      "id": "faith-identity",
      "statement": "Catalog row is exact passcode31560081 Magician of Faith, FLIP Spellcaster LIGHT level1 ATK300 DEF400; source is cards.cdb from immutable BabelCDB snapshot.",
      "evidence": [
        "catalogue-excerpt.json"
      ]
    },
    {
      "id": "mandatory-no-cost-no-hopt",
      "statement": "SINGLE+FLIP without optional marker, SetCost or SetCountLimit. Card text has no you-can.",
      "evidence": [
        "faith-c31560081.lua:6-13",
        "catalogue-excerpt.json"
      ]
    },
    {
      "id": "mandatory-no-target",
      "statement": "Target activation check returns true unconditionally; selection attempts ownGYSpell abletohand; operation only moves an existing related firsttarget. Technical implementation therefore creates mandatory activation even with zero legal Spell targets, resolving without adding. Do not reject Flip procedure or omit mandatory effect solely for zero targets.",
      "evidence": [
        "faith-c31560081.lua:15-29"
      ],
      "qualification": "Secondary technical contract, no new official Konami ruling captured. Other global activation prohibitions still require their reviewed rules."
    },
    {
      "id": "all-legal-targets",
      "statement": "A zero-target branch requires genuinely zero legal targets across ownGY. A Spell omitted from a reviewed allowlist is not evidence of zero legal targets; unsupported movement must exclude the affected packet instead.",
      "evidence": [
        "faith-c31560081.lua:15-23"
      ]
    },
    {
      "id": "target-resolution",
      "statement": "Target own controllerGYSpell abletohand. Recheck same physical copy and relation at resolution; no retarget if moved. SendtoHand nil means target owner hand; explicitly reveal to opponent. Faith itself need not remain onfield for its separately resolving effect unless negated by a registered response.",
      "evidence": [
        "faith-c31560081.lua:18-29"
      ]
    },
    {
      "id": "real-flip-procedure",
      "statement": "FlipSummon engine sets faceupATTACK and raises EVENT_FLIP+FLIP_SUMMON_SUCCESS+CHANGE_POS on actual successful procedure. This is not Normal/Special arrival or manufactured by initialfaceupsetup.",
      "evidence": [
        "operations.cpp:2362-2365",
        "operations.cpp:2414-2419"
      ]
    },
    {
      "id": "battle-flip-timing",
      "statement": "Battle sets flip_delayed before turning facedown target up. Damage calculation and LPdamage happen first. Destruction prevention/replacements and BATTLE_DESTROYED marking happen before releasing delayed FLIP events. PointEvent resolves before battleDestroy sends remaining victims.",
      "evidence": [
        "processor.cpp:2280",
        "processor.cpp:2324-2330",
        "processor.cpp:2484-2606",
        "processor.cpp:2605-2655"
      ]
    },
    {
      "id": "prevention-before-flip",
      "statement": "Consume/decide Spark or other reviewed first-destruction prevention against the battle event before releasing Flip responses. Delay physical graveyard departure, not prevention selection; otherwise a later Roar could wrongly consume protection meant for earlier battle.",
      "evidence": [
        "processor.cpp:2507-2606"
      ]
    },
    {
      "id": "mechaba-damage",
      "statement": "Mechaba Quick has explicit DAMAGE_STEP+DAMAGE_CAL flags. Its negcon own e:GetHandler() (Mechaba) must not be BATTLE_DESTROYED. This does NOT prohibit Faith re:GetHandler() from triggering while battleDestroyed. Cost is same type as activatedeffect: a Monster fromhand for Faith. Successful activation negation non-target banishes related source.",
      "evidence": [
        "c75286621.lua:12-16",
        "c75286621.lua:24-34",
        "c75286621.lua:48-50"
      ]
    },
    {
      "id": "roar-damage",
      "statement": "Roar is CounterTrap per catalog and ACTIVATE on CHAINING, negating activation then non-target destroying still-related source. Core exempts TYPE_COUNTER from ordinary DamageStepflags requirement.",
      "evidence": [
        "c51339637.lua:10-16",
        "c51339637.lua:38-54",
        "effect.cpp:156-163",
        "catalogue-excerpt.json"
      ]
    },
    {
      "id": "roar-battle-destroyed",
      "statement": "Technical static call path permits Roar effect-destroying a Faith already marked battleDestroyed: processor clears DESTROY_CONFIRMED when setting BATTLE_DESTROYED; Destroy only skips existing DESTROY_CONFIRMED; is_destructable rejects overlay/GY/banished, not battleDestroyed; is_affect_by_effect likewise does not reject battleDestroyed. Targeting a battleDestroyed card is separately prohibited, irrelevant to non-target Roar/Mechaba.",
      "evidence": [
        "processor.cpp:2578-2579",
        "operations.cpp:255-281",
        "operations.cpp:3804-3820",
        "card.cpp:3436-3463",
        "card.cpp:3883-3886"
      ],
      "qualification": "Static source review, not running the engine or official ruling certification."
    },
    {
      "id": "cleanup-location",
      "statement": "After response chain completes, battlecleanup removes victim from destructiongroup if no longer MZONE or no longer same field stay. Thus Mechaba banish or Roar effectGY must not be followed by a second battleGY transition.",
      "evidence": [
        "processor.cpp:2643-2656"
      ]
    },
    {
      "id": "excluded-damage-responses",
      "statement": "Imperm, Crow and Chixiao Quick have no applicable DAMAGE_STEP flags. Veiler explicitly requires opponentMain. Core rejects these normal activations in DamageStep without reviewed exceptions. Do not infer these response permissions just from phaseBATTLE.",
      "evidence": [
        "c10045474.lua:8-12",
        "c24508238.lua:8-14",
        "c97268402.lua:21-22",
        "c69248256.lua:24-31",
        "effect.cpp:156-163",
        "effect.cpp:246-251"
      ]
    },
    {
      "id": "controller-not-owner",
      "statement": "GY target belongs to the triggering controller, not original owner of Faith. The target callback uses IsControler(tp) and SelectTarget(tp,... ownGY=LOCATION_GRAVE, opposingGY=0). Core assigns triggering_player from the triggering controller (or previous controller for temporary reason).",
      "evidence": [
        "faith-c31560081.lua:19-22",
        "processor.cpp:1422-1430"
      ]
    },
    {
      "id": "mandatory-effect-negated",
      "statement": "Core queues a mandatory FLIP chain, then if its source has EFFECT_DISABLE_EFFECT creates EFFECT_DISABLE_CHAIN for that chain. Negated effects still activate unless a separate reviewed activation prohibition applies; do not omit pending or incorrectly treat zero-target as a reason to skip the mandatory chain.",
      "evidence": [
        "processor.cpp:1405-1443"
      ]
    }
  ],
